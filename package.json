{
  "name": "@aloftdata/deploy-map",
  "version": "0.0.0",
  "description": "JS library to show deployments on a map",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/deploy-map.js",
  "module": "./dist/deploy-map.esm.js",
  "exports": {
    ".": {
      "import": "./dist/deploy-map.esm.js",
      "default": "./dist/deploy-map.js"
    },
    "./dist/deploy-map.css": "./dist/deploy-map.css"
  },
  "scripts": {
    "build": "vite build && vite build --mode esm",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "leaflet": "2.0.0-beta.5",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
