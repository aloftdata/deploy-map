{
  "name": "@aloftdata/deploy-map",
  "version": "0.1.0",
  "description": "Show a set of points on a map and in a table, with filters, colours and a legend",
  "keywords": [
    "map",
    "leaflet",
    "geojson",
    "widget",
    "filters",
    "vue"
  ],
  "homepage": "https://aloftdata.github.io/deploy-map/",
  "bugs": "https://github.com/aloftdata/deploy-map/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aloftdata/deploy-map.git",
    "directory": "packages/deploy-map"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/deploy-map.esm.js",
  "module": "./dist/deploy-map.esm.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/deploy-map.js",
  "jsdelivr": "./dist/deploy-map.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/deploy-map.esm.js"
    },
    "./dist/deploy-map.css": "./dist/deploy-map.css",
    "./dist/deploy-map.bootstrap.css": "./dist/deploy-map.bootstrap.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build --mode esm && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "leaflet": "2.0.0-beta.5"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "bootstrap": "~5.3.9",
    "sass": "^1.108.2",
    "vue": "^3.5.46"
  }
}
